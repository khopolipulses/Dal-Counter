<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera: the app takes photos itself, so the phone's camera app cannot add a watermark.
         Gallery photos come from the system picker and results are saved through MediaStore, so no storage
         permission is needed. There is no INTERNET permission: the app cannot reach the network at all. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:icon="@drawable/ic_launcher"
        android:label="Grain Counter"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share" a photo from the gallery straight into the counter -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Portrait keeps the viewfinder and the saved photo's orientation simple; the photo still records how
             the phone was held. -->
        <activity
            android:name=".CameraActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- Hands one picture at a time to the app the user shares with: not exported, read-only, per-Uri grants. -->
        <provider
            android:name=".ShareProvider"
            android:authorities="com.dalcounter.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
